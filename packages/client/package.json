{
  "name": "reactor-effect-client",
  "version": "0.9.0",
  "description": "Scoped Reactor sessions, H3 provider state and explicit orchestration over Effect",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./internal/*": null,
    "./index": null
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  }
}
