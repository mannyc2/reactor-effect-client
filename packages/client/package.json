{
  "name": "reactor-effect-client",
  "version": "0.9.1",
  "description": "Effect SDK for Reactor's real-time video models: sessions and tokens, the H3 provider, a playout that keeps a channel on air across session caps, and Reactor simulated in memory for offline tests",
  "keywords": [
    "reactor",
    "reactor.inc",
    "effect",
    "effect-ts",
    "real-time video",
    "world models",
    "generative video",
    "h3",
    "webrtc",
    "livestream",
    "playout",
    "sdk"
  ],
  "homepage": "https://mannyc2.github.io/reactor-effect-client/",
  "bugs": {
    "url": "https://github.com/mannyc2/reactor-effect-client/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./internal/*": null,
    "./index": null
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  }
}
