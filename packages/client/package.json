{
  "name": "reactor-effect-client",
  "version": "0.7.0",
  "description": "Scoped Reactor sessions, H3 provider state and explicit orchestration over Effect",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Coordinator": {
      "types": "./dist/Coordinator.d.ts",
      "import": "./dist/Coordinator.js"
    },
    "./H3": {
      "types": "./dist/H3.d.ts",
      "import": "./dist/H3.js"
    },
    "./H3Source": {
      "types": "./dist/H3Source.d.ts",
      "import": "./dist/H3Source.js"
    },
    "./LocalSource": {
      "types": "./dist/LocalSource.d.ts",
      "import": "./dist/LocalSource.js"
    },
    "./Media": {
      "types": "./dist/Media.d.ts",
      "import": "./dist/Media.js"
    },
    "./Peer": {
      "types": "./dist/Peer.d.ts",
      "import": "./dist/Peer.js"
    },
    "./Playout": {
      "types": "./dist/Playout.d.ts",
      "import": "./dist/Playout.js"
    },
    "./Reactor": {
      "types": "./dist/Reactor.d.ts",
      "import": "./dist/Reactor.js"
    },
    "./ReactorError": {
      "types": "./dist/ReactorError.d.ts",
      "import": "./dist/ReactorError.js"
    },
    "./ReactorTest": {
      "types": "./dist/ReactorTest.d.ts",
      "import": "./dist/ReactorTest.js"
    },
    "./Session": {
      "types": "./dist/Session.d.ts",
      "import": "./dist/Session.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "generate:wire": "buf generate --template wire/buf.gen.yaml",
    "generate:check": "buf generate --template wire/buf.gen.yaml --output node_modules/.wire-check && diff -r node_modules/.wire-check/src/internal/proto src/internal/proto"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  }
}
