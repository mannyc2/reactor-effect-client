{
  "name": "reactor-effect-client",
  "version": "0.7.0",
  "description": "Scoped Reactor sessions, H3 provider state and explicit orchestration over Effect",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Coordinator": {
      "types": "./dist/Coordinator.d.ts",
      "import": "./dist/Coordinator.js"
    },
    "./H3": {
      "types": "./dist/H3.d.ts",
      "import": "./dist/H3.js"
    },
    "./Media": {
      "types": "./dist/Media.d.ts",
      "import": "./dist/Media.js"
    },
    "./Peer": {
      "types": "./dist/Peer.d.ts",
      "import": "./dist/Peer.js"
    },
    "./Reactor": {
      "types": "./dist/Reactor.d.ts",
      "import": "./dist/Reactor.js"
    },
    "./ReactorError": {
      "types": "./dist/ReactorError.d.ts",
      "import": "./dist/ReactorError.js"
    },
    "./ReactorTest": {
      "types": "./dist/ReactorTest.d.ts",
      "import": "./dist/ReactorTest.js"
    },
    "./Session": {
      "types": "./dist/Session.d.ts",
      "import": "./dist/Session.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration/index.d.ts",
      "import": "./dist/orchestration/index.js"
    },
    "./simulation": {
      "types": "./dist/simulation/index.d.ts",
      "import": "./dist/simulation/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "reactor-effect-test-kit": "workspace:*",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "generate:wire": "python3 wire/generate.py",
    "generate:check": "python3 wire/generate.py --check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
