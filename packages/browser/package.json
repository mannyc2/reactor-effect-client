{
  "name": "reactor-effect-browser",
  "version": "0.7.0",
  "description": "Browser WebRTC host for reactor-effect-client: the Peer port on RTCPeerConnection, and local playback of session tracks",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/browser"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./BrowserMedia": {
      "types": "./dist/BrowserMedia.d.ts",
      "import": "./dist/BrowserMedia.js"
    },
    "./BrowserPeer": {
      "types": "./dist/BrowserPeer.d.ts",
      "import": "./dist/BrowserPeer.js"
    }
  },
  "peerDependencies": {
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
