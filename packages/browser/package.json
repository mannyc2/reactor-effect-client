{
  "name": "reactor-effect-browser",
  "version": "0.9.0",
  "description": "Reactor sessions in the browser for reactor-effect-client: the session transport on RTCPeerConnection and playback of its tracks",
  "keywords": [
    "reactor",
    "reactor.inc",
    "effect",
    "effect-ts",
    "webrtc",
    "browser",
    "real-time video",
    "generative video"
  ],
  "homepage": "https://mannyc2.github.io/reactor-effect-client/",
  "bugs": {
    "url": "https://github.com/mannyc2/reactor-effect-client/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/browser"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./internal/*": null,
    "./index": null
  },
  "peerDependencies": {
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
