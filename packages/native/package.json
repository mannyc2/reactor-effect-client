{
  "name": "reactor-effect-native",
  "version": "0.9.1",
  "description": "Native WebRTC host for reactor-effect-client: the Peer port on a libwebrtc Node-API addon, in process or isolated per connection",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/reactor-effect-client.git",
    "directory": "packages/native"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "notices",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./internal/*": null,
    "./index": null
  },
  "engines": {
    "node": ">=22"
  },
  "napi": {
    "binaryName": "reactor-effect-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*"
  },
  "optionalDependencies": {
    "reactor-effect-native-darwin-arm64": "workspace:*",
    "reactor-effect-native-linux-x64-gnu": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "reactor-effect-client": "workspace:*",
    "vitest": "catalog:",
    "@napi-rs/cli": "3.10.5"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "native:build": "sh scripts/build.sh",
    "native:test": "sh scripts/test.sh",
    "native:test:node": "sh scripts/test.sh node",
    "native:linux-x64": "sh scripts/linux-x64.sh"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
