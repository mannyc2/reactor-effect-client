 /// Errors surfaced by the WebRTC engine.
 #[derive(Debug, Clone)]
+#[non_exhaustive]
 pub enum Error {
-    /// A WebRTC operation failed (SDP, ICE, transport, …).
+    /// A WebRTC operation failed without a typed native cause (Rust-side
+    /// validation, or a native call that reports only success or failure).
     Webrtc(String),
     /// The requested track/transceiver/data-channel was not found.
     NotFound(String),
+    /// libwebrtc rejected an operation with a typed `RTCError`.
+    Rtc {
+        /// The operation that failed, e.g. `"set_remote_description"`.
+        operation: &'static str,
+        kind: RtcErrorKind,
+        message: String,
+    },
+    /// A blocking call waited [`OP_TIMEOUT`](crate) for the signaling thread.
+    Timeout(&'static str),
+}
+
+/// `webrtc::RTCErrorType`, plus the glue's own refusal.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum RtcErrorKind {
+    UnsupportedOperation,
+    UnsupportedParameter,
+    InvalidParameter,
+    InvalidRange,
+    /// The SDP or candidate did not parse.
+    SyntaxError,
+    InvalidState,
+    InvalidModification,
+    NetworkError,
+    ResourceExhausted,
+    InternalError,
+    OperationErrorWithData,
+    /// The connection handle was already gone when the call reached the glue.
+    NoPeerConnection,
+    Other(i32),
+}
+
+impl RtcErrorKind {
+    pub(crate) fn from_native(code: std::os::raw::c_int) -> Self {
+        match code {
+            1 => Self::UnsupportedOperation,
+            2 => Self::UnsupportedParameter,
+            3 => Self::InvalidParameter,
+            4 => Self::InvalidRange,
+            5 => Self::SyntaxError,
+            6 => Self::InvalidState,
+            7 => Self::InvalidModification,
+            8 => Self::NetworkError,
+            9 => Self::ResourceExhausted,
+            10 => Self::InternalError,
+            11 => Self::OperationErrorWithData,
+            1000 => Self::NoPeerConnection,
+            other => Self::Other(other),
+        }
+    }
 }
 
 impl std::fmt::Display for Error {
@@ -115,6 +167,14 @@ impl std::fmt::Display for Error {
         match self {
             Error::Webrtc(m) => write!(f, "webrtc error: {m}"),
             Error::NotFound(m) => write!(f, "not found: {m}"),
+            Error::Rtc {
+                operation,
+                kind,
+                message,
+            } => {
+                write!(f, "{operation} failed ({kind:?}): {message}")
+            }
+            Error::Timeout(operation) => write!(f, "{operation} timed out"),
         }
     }
 }
