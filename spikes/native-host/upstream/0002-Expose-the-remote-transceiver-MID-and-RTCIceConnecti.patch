+
+/// `RTCIceConnectionState`. Unlike [`PeerConnectionState`] it excludes DTLS, so
+/// `Failed` here means no candidate pair worked.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum IceConnectionState {
+    New,
+    Checking,
+    Connected,
+    Completed,
+    Failed,
+    Disconnected,
+    Closed,
+}
+
+impl IceConnectionState {
+    fn from_raw(v: c_int) -> Self {
+        match v {
+            1 => Self::Checking,
+            2 => Self::Connected,
+            3 => Self::Completed,
+            4 => Self::Failed,
+            5 => Self::Disconnected,
+            6 => Self::Closed,
+            _ => Self::New,
+        }
+    }
+}
 type DataChannelCb = Box<dyn FnMut(DataChannel) + Send>;
 
