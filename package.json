{
  "name": "reactor-effect-client",
  "version": "0.2.0",
  "description": "Scoped Reactor sessions, H3 provider state, media and explicit orchestration over Effect",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "files": [
    "dist",
    "native/include",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/build.rs",
    "native/stage.mjs",
    "native/.cargo/config.toml",
    "native/src",
    "native/README.md",
    "native/install-linux-toolchain.sh",
    "LICENSE",
    "NOTICE",
    "notices",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "native/Dockerfile"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./h3": {
      "types": "./dist/h3/index.d.ts",
      "import": "./dist/h3/index.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration/index.d.ts",
      "import": "./dist/orchestration/index.js"
    },
    "./simulation": {
      "types": "./dist/simulation/index.d.ts",
      "import": "./dist/simulation/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  },
  "optionalDependencies": {
    "koffi": "3.2.1"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "22.20.2",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "oxlint": "1.81.0",
    "oxfmt": "0.70.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src test testing scripts integration vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:wire": "python3 scripts/generate-wire.py",
    "generate:check": "python3 scripts/generate-wire.py --check",
    "test": "bun run test:portable",
    "test:portable": "bun --no-env-file scripts/test.ts portable",
    "test:native": "bun --no-env-file scripts/test.ts native",
    "test:integration": "bun --no-env-file scripts/test.ts integration",
    "verify": "bun --no-env-file scripts/verify.ts",
    "test:pack": "bun --no-env-file scripts/pack.ts",
    "native:build": "sh scripts/native-build.sh",
    "native:test": "sh scripts/native-test.sh",
    "native:linux-x64": "sh scripts/native-linux-x64.sh"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115"
  }
}
