{
  "name": "reactor-effect",
  "private": true,
  "version": "0.3.0-rc.0",
  "description": "Bun workspace for the reactor-effect-client, reactor-effect-browser and reactor-effect-native packages",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples",
      "integration"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/platform-node": "4.0.0-rc.115",
      "@effect/vitest": "4.0.0-rc.115",
      "@types/bun": "1.4.2",
      "@types/node": "22.20.2",
      "effect": "4.0.0-rc.115",
      "koffi": "3.2.1",
      "typescript": "7.0.2",
      "vitest": "5.0.0"
    }
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "0.70.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "reactor-effect-browser": "workspace:*",
    "reactor-effect-client": "workspace:*",
    "reactor-effect-native": "workspace:*",
    "typescript": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --ignore-pattern 'release-tools/**' .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:wire": "bun run --filter reactor-effect-client generate:wire",
    "generate:check": "bun run --filter reactor-effect-client generate:check",
    "check:architecture": "node scripts/architecture.mjs",
    "check:examples": "bun run --filter reactor-effect-examples check",
    "test": "bun --no-env-file scripts/test.ts portable",
    "test:portable": "bun --no-env-file scripts/test.ts portable",
    "test:native": "bun --no-env-file scripts/test.ts native",
    "test:integration": "bun --no-env-file scripts/test.ts integration",
    "test:pack": "bun --no-env-file scripts/pack.ts",
    "verify": "bun --no-env-file scripts/verify.ts",
    "native:build": "bun run --filter reactor-effect-native native:build",
    "native:test": "bun run --filter reactor-effect-native native:test",
    "native:linux-x64": "bun run --filter reactor-effect-native native:linux-x64",
    "check:release": "tsc -p release-tools/tsconfig.json --noEmit && oxlint -c .oxlintrc.json --deny-warnings release-tools && cd release-tools && bun --no-env-file test ./test"
  }
}
