{
  "name": "reactor-effect-integration",
  "version": "0.9.0",
  "private": true,
  "description": "Real local browser/native WebRTC qualification over the public host packages",
  "type": "module",
  "devDependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "reactor-effect-browser": "workspace:*",
    "reactor-effect-client": "workspace:*",
    "reactor-effect-native": "workspace:*",
    "vitest": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "browser-native": "sh scripts/browser-native.sh",
    "hosted": "bun --no-env-file hosted/main.ts",
    "test:hosted": "vitest run --root hosted"
  }
}
