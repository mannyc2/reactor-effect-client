{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["bun"],
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["test/**/*.ts", "scripts/*.mjs", "vitest.config.ts"],
  // The paid hosted harness is rewritten onto ReactorTest in a later step; until
  // then it is outside the gates.
  "exclude": ["test/hosted-*.test.ts"]
}
