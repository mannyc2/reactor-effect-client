{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".check/**",
    "native/**",
    "fixtures/**",
    "notices/**",
    "src/wire.generated.ts",
    "bun.lock",
    "work/refactor-evidence/**"
  ]
}
