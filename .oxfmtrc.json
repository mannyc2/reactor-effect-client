{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".check/**",
    "**/notices/**",
    "packages/client/src/wire.generated.ts",
    "packages/client/wire/**",
    "packages/native/lib/**",
    "packages/native/rust/**",
    "bun.lock",
    "work/refactor-evidence/**"
  ]
}
