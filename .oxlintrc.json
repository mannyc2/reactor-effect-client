{
  "plugins": ["typescript"],
  "categories": { "correctness": "error" },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-this-alias": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    ".check/**",
    "packages/native/lib/**",
    "packages/native/rust/**",
    "work/**"
  ]
}
