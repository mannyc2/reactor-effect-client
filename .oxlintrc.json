{
  "plugins": ["typescript"],
  "categories": { "correctness": "error" },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-this-alias": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "native/target/**",
    "node_modules/**",
    "release-tools/node_modules/**"
  ]
}
